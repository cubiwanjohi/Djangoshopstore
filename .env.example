# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# If the key contains $ or #, wrap it in single quotes: SECRET_KEY='...'
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# True = SQLite (plain local run). Docker Compose overrides this to False.
USE_SQLITE=True

# --- PostgreSQL (used by Docker; the db container reads these too) ---
POSTGRES_DB=shopdb
POSTGRES_USER=shopuser
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- M-Pesa Daraja (sandbox) ---
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-sandbox-passkey
MPESA_CALLBACK_URL=https://your-tunnel-domain.ngrok-free.dev/mpesa/callback/
MPESA_BASE_URL=https://sandbox.safaricom.co.ke